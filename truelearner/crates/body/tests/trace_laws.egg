(relation eligible (i64 i64 i64))
(relation candidate-at (i64 i64 i64))
(relation present (i64 i64 i64))
(relation candidate (i64 i64))
(relation chosen (i64 i64))
(relation effect (i64 i64))
(relation returned (i64 i64))
(relation path-chosen (i64 i64))
(relation moved (i64 i64))
(relation closed (i64 i64))

(rule ((eligible cause sensor motor)
       (candidate-at cause sensor motor))
      ((present cause sensor motor)))
(rule ((candidate cause motor)
       (chosen cause motor))
      ((path-chosen cause motor)))
(rule ((path-chosen cause motor)
       (effect cause motor))
      ((moved cause motor)))
(rule ((moved cause motor)
       (returned cause motor))
      ((closed cause motor)))
